# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# From your Supabase project: Settings -> Database -> Connection string (URI, "Session" mode)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Where your frontend runs (comma-separate if you need more than one)
CORS_ORIGIN=http://localhost:5173

# From console.groq.com
GROQ_API_KEY=your_groq_key
